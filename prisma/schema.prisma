// Beursradar database-schema (PostgreSQL, bijv. Vercel Postgres / Neon of een lokale server).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Anoniem profiel per browser (cookie), zodat data per gebruiker gescheiden blijft zonder login.
model Profile {
  id                String             @id
  createdAt         DateTime           @default(now())
  watchlist         WatchlistItem[]
  positions         Position[]
  /// Ingevuld als iemand een account met dit profiel heeft gemaakt
  user              User?
  pushSubscriptions PushSubscription[]
  sellAlerts        SellAlert[]
}

/// Account met gebruikersnaam en wachtwoord; bezit precies één profiel (portfolio + watchlist).
model User {
  id           String    @id @default(cuid())
  /// Kleine letters, uniek
  username     String    @unique
  /// scrypt-hash met eigen salt, nooit het wachtwoord zelf
  passwordHash String
  profileId    String    @unique
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Mislukte inlogpogingen op rij; na 5 even op slot
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

/// Inlogsessie. Het id is de SHA-256 van het token in de cookie, zodat een databaselek geen geldige cookies oplevert.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  type      String // "stock" | "crypto"
  addedAt   DateTime @default(now())

  @@unique([profileId, type, symbol])
  @@index([profileId])
}

model Position {
  id        String   @id
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  type      String // "stock" | "crypto"
  quantity  Float
  buyPrice  Float
  buyDate   String // ISO-datum (YYYY-MM-DD)
  currency  String
  /// Tradeplan op het moment van kopen (leeg bij handmatig ingevoerde posities)
  stopLoss  Float?
  target1   Float?
  target2   Float?
  /// "short" (weken) of "long" (maanden tot jaren): bepaalt welk signaal het verkoopadvies volgt
  horizon   String   @default("short")
  createdAt DateTime @default(now())

  @@index([profileId])
}

/// Aantal AI-chatberichten per dag (per profiel en totaal), om kosten te begrenzen.
model ChatUsage {
  key   String
  day   String // YYYY-MM-DD (UTC)
  count Int    @default(0)

  @@id([key, day])
}

/// Elke koopkans die de app toonde, om achteraf eerlijk te meten hoe goed de tips waren.
model Tip {
  id        String   @id @default(cuid())
  symbol    String
  type      String // "stock" | "crypto"
  name      String
  horizon   String // "short" | "long"
  currency  String
  /// Koers op het moment van de tip
  entry     Float
  stopLoss  Float
  target1   Float?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, symbol, horizon])
}

/// Een toestel dat pushmeldingen wil krijgen (Web Push)
model PushSubscription {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([profileId])
}

/// Verstuurde verkoopmelding, zodat dezelfde melding niet elk half uur opnieuw komt
model SellAlert {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  positionId String
  action     String
  createdAt  DateTime @default(now())

  @@index([profileId, positionId])
}

/// Sleutels die de app zelf aanmaakt (zoals de VAPID-sleutels voor pushmeldingen)
model AppSecret {
  key   String @id
  value String
}
