// Beursradar database-schema (PostgreSQL, bijv. Vercel Postgres / Neon of een lokale server).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Anoniem profiel per browser (cookie), zodat data per gebruiker gescheiden blijft zonder login.
model Profile {
  id        String          @id
  createdAt DateTime        @default(now())
  watchlist WatchlistItem[]
  positions Position[]
}

model WatchlistItem {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  type      String // "stock" | "crypto"
  addedAt   DateTime @default(now())

  @@unique([profileId, type, symbol])
  @@index([profileId])
}

model Position {
  id        String   @id
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  type      String // "stock" | "crypto"
  quantity  Float
  buyPrice  Float
  buyDate   String // ISO-datum (YYYY-MM-DD)
  currency  String
  /// Tradeplan op het moment van kopen (leeg bij handmatig ingevoerde posities)
  stopLoss  Float?
  target1   Float?
  target2   Float?
  /// "short" (weken) of "long" (maanden tot jaren): bepaalt welk signaal het verkoopadvies volgt
  horizon   String   @default("short")
  createdAt DateTime @default(now())

  @@index([profileId])
}

/// Aantal AI-chatberichten per dag (per profiel en totaal), om kosten te begrenzen.
model ChatUsage {
  key   String
  day   String // YYYY-MM-DD (UTC)
  count Int    @default(0)

  @@id([key, day])
}

/// Elke koopkans die de app toonde, om achteraf eerlijk te meten hoe goed de tips waren.
model Tip {
  id        String   @id @default(cuid())
  symbol    String
  type      String // "stock" | "crypto"
  name      String
  horizon   String // "short" | "long"
  currency  String
  /// Koers op het moment van de tip
  entry     Float
  stopLoss  Float
  target1   Float?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, symbol, horizon])
}
