# PostgreSQL-database voor watchlist en portfolio (Prisma). Laat leeg om alles alleen in
# de browser (LocalStorage) op te slaan. Na instellen: npm run db:migrate
# Voorbeeld lokaal: postgresql://postgres:postgres@localhost:5432/beursradar
# Op Vercel wordt deze automatisch gezet als je een Postgres-database (Neon) koppelt.
DATABASE_URL=

# Wachtwoord voor de hele app: alleen wie dit kent kan de site gebruiken (één gebruiker).
# Leeg = de app is voor iedereen open. Een nieuw wachtwoord logt alle toestellen uit.
APP_PASSWORD=

# Alle sleutels hieronder zijn OPTIONEEL. Zonder sleutels valt de app automatisch terug op
# publieke endpoints en, als die falen of rate-limited zijn, op realistische mock-data.

# CoinGecko Demo API key (https://www.coingecko.com/en/api) — verhoogt rate limits
COINGECKO_API_KEY=

# FRED API key (https://fred.stlouisfed.org/docs/api/api_key.html) — zonder sleutel gebruikt de app de openbare CSV
FRED_API_KEY=

# Anthropic API key (https://console.anthropic.com) — activeert de AI-assistent en de AI-samenvatting.
# Kosten: ± $0,05 per vraag. Zet ook een maandlimiet in de Anthropic Console.
ANTHROPIC_API_KEY=
# Optioneel: toegangscode voor de AI-assistent (aan te raden op een openbare site)
CHAT_ACCESS_CODE=
# Optioneel: daglimieten voor de AI-assistent (standaard 20 per bezoeker, 100 in totaal)
CHAT_PER_USER_DAILY=
CHAT_GLOBAL_DAILY=

# Forceer mock-data (handig voor demo's/offline ontwikkeling): "1" om aan te zetten
USE_MOCK_DATA=
